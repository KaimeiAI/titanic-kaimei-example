# Copy this file to .env (which git ignores) and fill in your key.
# Create one at https://dashboard.kaimei.ai -> API keys.
KAIMEI_API_KEY=km_live_...

# Optional: another Kaimei API (for example one running locally) and its dashboard.
# KAIMEI_BASE_URL=http://localhost:8000
# KAIMEI_DASHBOARD_URL=http://localhost:5173

# Optional (notebook 04): run the scoring service on a fixed port, and the public URL of a tunnel
# to it (e.g. cloudflared tunnel --url http://127.0.0.1:8765), so Kaimei can call it.
# TITANIC_SCORING_PORT=8765
# TITANIC_SCORING_URL=https://your-tunnel.trycloudflare.com
